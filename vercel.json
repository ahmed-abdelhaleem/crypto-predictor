{
  "version": 2,
  "builds": [
    {
      "src": "dist/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "OAUTH_SERVER_URL": "https://placeholder.invalid",
    "JWT_SECRET": "crypto-oracle-secret-2026",
    "LLM_MODEL": "gpt-4.1-mini"
  }
}
